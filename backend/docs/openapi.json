            }
          },
          {
            "name": "planting_date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Planting Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
