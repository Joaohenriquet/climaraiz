    },
    "/api/v1/planting/analyses/{analysis_id}/dates/{planting_date}": {
      "get": {
        "tags": [
          "Planting"
        ],
        "summary": "Analysis Date",
        "operationId": "analysis_date_api_v1_planting_analyses__analysis_id__dates__planting_date__get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          },
          {
            "name": "planting_date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Planting Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/planting/analyses/{analysis_id}/dates/{planting_date}/phases": {
      "get": {
        "tags": [
          "Planting"
        ],
        "summary": "Phases",
        "operationId": "phases_api_v1_planting_analyses__analysis_id__dates__planting_date__phases_get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
