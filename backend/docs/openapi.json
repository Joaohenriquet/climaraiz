              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckWindow": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,49}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "start_day": {
            "type": "integer",
            "maximum": 364.0,
            "minimum": 0.0,
            "title": "Start Day"
          },
          "end_day": {
            "type": "integer",
            "maximum": 364.0,
            "minimum": 0.0,
            "title": "End Day"
          },
          "phase_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase Id",
            "description": "Optional ID of the submitted cycle segment receiving this check window's results. The window must be entirely inside that segment; its own ID still selects the crop rules."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "start_day",
          "end_day"
        ],
        "title": "CheckWindow"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoricalPeriod": {
        "properties": {
          "start_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1900.0,
            "title": "Start Year",
            "default": 2001
          },
          "end_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1900.0,
            "title": "End Year",
            "default": 2025
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "HistoricalPeriod"
      },
      "PlantingRequest": {
        "properties": {
          "municipality_id": {
            "type": "integer",
            "title": "Municipality Id",
            "default": 2504009
          },
          "crop_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Crop Id",
            "description": "Numeric crop ID returned by GET /api/v1/crops."
          },
          "production_system": {
            "type": "string",
            "const": "rainfed",
            "title": "Production System",
            "default": "rainfed"
          },
          "planting_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Planting Year"
          },
          "historical_period": {
            "$ref": "#/components/schemas/HistoricalPeriod"
          },
          "cycle_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Cycle Days",
            "description": "User-selected scenario duration; not a validated crop profile."
          },
          "phases": {
            "items": {
              "$ref": "#/components/schemas/ScenarioPhase"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Phases"
          },
          "check_windows": {
            "items": {
              "$ref": "#/components/schemas/CheckWindow"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Check Windows",
            "description": "Optional rule-evaluation windows; inclusive cycle-day offsets may overlap, e.g. pollination within flowering. Not validated crop phenology."
          },
          "daily_mean_threshold_c": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 60.0,
                "minimum": -50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Mean Threshold C",
            "description": "Optional descriptive threshold for daily mean temperature. Not a crop stress limit."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "crop_id",
          "planting_year",
          "cycle_days"
        ],
        "title": "PlantingRequest"
      },
      "ScenarioPhase": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,49}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "start_day": {
            "type": "integer",
            "maximum": 364.0,
            "minimum": 0.0,
            "title": "Start Day"
          },
          "end_day": {
            "type": "integer",
            "maximum": 364.0,
            "minimum": 0.0,
            "title": "End Day"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "start_day",
          "end_day"
        ],
        "title": "ScenarioPhase"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}